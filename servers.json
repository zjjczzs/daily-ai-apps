{
  "servers": [
    {
      "id": "context7",
      "name": "Context7",
      "description": "为LLM提供最新代码文档的MCP服务器",
      "transport": "stdio",
      "command": "npx -y @upstash/context7-mcp@latest",
      "url": null,
      "category": "documentation",
      "tags": ["docs", "code", "upstash"],
      "stars": 44967,
      "github_url": "https://github.com/upstash/context7",
      "tools": [
        {
          "name": "resolve-library-id",
          "description": "解析库ID",
          "parameters": {
            "type": "object",
            "properties": {
              "library": {"type": "string", "description": "库名称"}
            }
          }
        },
        {
          "name": "get-library-docs",
          "description": "获取库文档",
          "parameters": {
            "type": "object",
            "properties": {
              "library": {"type": "string"},
              "topic": {"type": "string"}
            }
          }
        }
      ]
    },
    {
      "id": "github",
      "name": "GitHub MCP",
      "description": "GitHub API集成，支持仓库、Issue、PR操作",
      "transport": "stdio",
      "command": "npx -y @modelcontextprotocol/server-github",
      "url": null,
      "category": "integration",
      "tags": ["github", "git", "api"],
      "stars": 8200,
      "github_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/github",
      "tools": [
        {
          "name": "create-issue",
          "description": "创建GitHub Issue",
          "parameters": {
            "type": "object",
            "properties": {
              "owner": {"type": "string"},
              "repo": {"type": "string"},
              "title": {"type": "string"},
              "body": {"type": "string"}
            }
          }
        },
        {
          "name": "search-code",
          "description": "搜索代码",
          "parameters": {
            "type": "object",
            "properties": {
              "q": {"type": "string", "description": "搜索查询"}
            }
          }
        }
      ]
    },
    {
      "id": "filesystem",
      "name": "Filesystem MCP",
      "description": "安全的文件系统操作MCP服务器",
      "transport": "stdio",
      "command": "npx -y @modelcontextprotocol/server-filesystem /allowed/path",
      "url": null,
      "category": "utility",
      "tags": ["files", "fs", "local"],
      "stars": 5300,
      "github_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "tools": [
        {
          "name": "read_file",
          "description": "读取文件内容",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {"type": "string"}
            }
          }
        },
        {
          "name": "write_file",
          "description": "写入文件",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "content": {"type": "string"}
            }
          }
        },
        {
          "name": "list_directory",
          "description": "列出目录内容",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {"type": "string"}
            }
          }
        }
      ]
    },
    {
      "id": "postgres",
      "name": "PostgreSQL MCP",
      "description": "PostgreSQL数据库查询MCP服务器",
      "transport": "stdio",
      "command": "npx -y @modelcontextprotocol/server-postgres postgresql://localhost/mydb",
      "url": null,
      "category": "database",
      "tags": ["postgres", "sql", "database"],
      "stars": 3200,
      "github_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/postgres",
      "tools": [
        {
          "name": "query",
          "description": "执行SQL查询",
          "parameters": {
            "type": "object",
            "properties": {
              "sql": {"type": "string", "description": "SQL查询语句"}
            }
          }
        }
      ]
    },
    {
      "id": "fetch",
      "name": "Fetch MCP",
      "description": "获取和处理Web内容的MCP服务器",
      "transport": "stdio",
      "command": "npx -y @modelcontextprotocol/server-fetch",
      "url": null,
      "category": "utility",
      "tags": ["http", "web", "fetch"],
      "stars": 2100,
      "github_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
      "tools": [
        {
          "name": "fetch",
          "description": "获取URL内容",
          "parameters": {
            "type": "object",
            "properties": {
              "url": {"type": "string", "description": "目标URL"},
              "max_length": {"type": "number", "description": "最大长度"}
            }
          }
        }
      ]
    },
    {
      "id": "puppeteer",
      "name": "Puppeteer MCP",
      "description": "浏览器自动化MCP服务器",
      "transport": "stdio",
      "command": "npx -y @modelcontextprotocol/server-puppeteer",
      "url": null,
      "category": "automation",
      "tags": ["browser", "puppeteer", "automation"],
      "stars": 1800,
      "github_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/puppeteer",
      "tools": [
        {
          "name": "puppeteer_navigate",
          "description": "导航到URL",
          "parameters": {
            "type": "object",
            "properties": {
              "url": {"type": "string"}
            }
          }
        },
        {
          "name": "puppeteer_screenshot",
          "description": "截取网页截图",
          "parameters": {
            "type": "object",
            "properties": {
              "name": {"type": "string"}
            }
          }
        }
      ]
    }
  ]
}
